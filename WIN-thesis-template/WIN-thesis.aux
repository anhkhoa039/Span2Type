\pgfsyspdfmark {pgfid26}{4736286}{47362867}
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Overview of the Span2Type framework. The pipeline consists of three stages: (1)~\textbf  {Mention Detection} — a multi-view DeBERTa-v3 detector with BIO, Start-End, and Tie-or-Break taggers produces a union of candidate mentions; (2)~\textbf  {Prompt-based Entity Encoding and Embedding Refinement} — each span is encoded via a fill-in-the-blank template with an optional soft prompt, and embeddings are refined using batch triplet contrastive learning; (3)~\textbf  {Entity Clustering and Cluster Naming} — BIC-guided $k$-means groups spans into types, and a Cluster Naming module assigns human-readable labels (e.g., Person, Location, Disease).\relax }}{16}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:span2type_framework}{{3.1}{16}{Overview of the Span2Type framework. The pipeline consists of three stages: (1)~\textbf {Mention Detection} — a multi-view DeBERTa-v3 detector with BIO, Start-End, and Tie-or-Break taggers produces a union of candidate mentions; (2)~\textbf {Prompt-based Entity Encoding and Embedding Refinement} — each span is encoded via a fill-in-the-blank template with an optional soft prompt, and embeddings are refined using batch triplet contrastive learning; (3)~\textbf {Entity Clustering and Cluster Naming} — BIC-guided $k$-means groups spans into types, and a Cluster Naming module assigns human-readable labels (e.g., Person, Location, Disease).\relax }{figure.caption.4}{}}
\citation{zhang-etal-2024-dtrans}
